# Copy to .env.local and fill in.

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Public URL of the app. Also used by server code to call its own API routes.
NEXTAUTH_URL=http://localhost:3000

# Python NLU service (nlu/serve.py)
NLU_URL=http://localhost:8000
